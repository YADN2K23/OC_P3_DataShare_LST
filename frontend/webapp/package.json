{
  "name": "webapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless --include=src/app/core/**/*.spec.ts",
    "test:integration": "ng test --watch=false --browsers=ChromeHeadless --include=src/app/pages/**/*.spec.ts",
    "test:functional": "ng test --watch=false --browsers=ChromeHeadless --include=src/app/functional/**/*.spec.ts",
    "test:coverage": "node run-coverage.mjs",
    "test:coverage:report": "node run-coverage.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:ci": "npm run test:unit && npm run test:integration && npm run test:functional && npm run test:e2e",
    "docker:build": "docker build -t datashare-webapp .",
    "docker:run": "docker run --rm -p 4200:80 datashare-webapp"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@angular/build": "^20.3.23",
    "@angular/cli": "^20.3.23",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
